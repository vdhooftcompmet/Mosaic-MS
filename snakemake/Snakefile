import os
from pathlib import Path

SNAKEFILE_DIR = Path(workflow.current_basedir).resolve()
REPO = SNAKEFILE_DIR.parent

configfile: str(SNAKEFILE_DIR / "config.yaml")

workdir: REPO

if os.name == "nt" and Path("C:/Program Files/Git/bin/bash.exe").exists():
    shell.executable("C:/Program Files/Git/bin/bash.exe")

OUT_DIR     = Path(config["paths"]["result_dir"])
INPUT_MGF   = Path(config["inputs"]["raw_mgf"])
STEM        = INPUT_MGF.stem
CLEANED_MGF = OUT_DIR / f"{STEM}_cleaned.mgf"

SIMILARITIES = config["parameters"]["similarity_types"]
SIZES        = config["parameters"]["max_component_sizes"]
MATRICES     = config["parameters"]["matrix_types"]
GRAPHS       = config["parameters"]["graph_types"]
MOTIFS       = config["parameters"]["nr_of_motifs"]

wildcard_constraints:
    sim    = "|".join(SIMILARITIES),
    size   = "|".join(str(x) for x in SIZES),
    matrix = "|".join(MATRICES),
    graph  = "|".join(GRAPHS),
    motifs = "|".join(str(x) for x in MOTIFS)

onstart:
    print("--- Starting Pre-flight Validation ---")
    assert INPUT_MGF.exists(), f"[Error] Input MGF file not found: {INPUT_MGF}"
    for name, path in config.get("models", {}).items():
        assert Path(path).exists(), f"[Error] Model path for '{name}' not found: {path}"
    for name, path in config.get("params_files", {}).items():
        assert Path(path).exists(), f"[Error] Parameter file for '{name}' not found: {path}"
    print("--- Pre-flight Validation Passed ---")

rule all:
    input:
        expand(
            str(OUT_DIR / "networks" / "{sim}" / "comp_{size}" / "{matrix}" / "{graph}.cx"),
            sim=SIMILARITIES, size=SIZES, matrix=MATRICES, graph=GRAPHS
        ),
        expand(
            str(OUT_DIR / "snapms" / "motifs_{motifs}" / "{sim}_comp_{size}_{matrix}_{graph}"),
            motifs=MOTIFS, sim=SIMILARITIES, size=SIZES, matrix=MATRICES, graph=GRAPHS
        ),
        expand(
            str(OUT_DIR / "ms2lda" / "motifs_{motifs}_plots"),
            motifs=MOTIFS
        )

rule clean_mgf:
    message:
        "Cleaning raw input MGF file: {input.mgf}"
    input:
        mgf = INPUT_MGF
    output:
        mgf = CLEANED_MGF
    log:
        OUT_DIR / "logs" / "clean_mgf.log"
    resources:
        mem_mb = 2000
    shell:
        """
        set -euo pipefail
        python src/utils/cleaning.py \
            --raw-mgf "{input.mgf}" \
            --cleaned-mgf "{output.mgf}" > {log} 2>&1
        """

rule mn:
    message:
        "Running Molecular Networking | Sim: {wildcards.sim} | Max Size: {wildcards.size} | Matrix: {wildcards.matrix}"
    input:
        mgf                = CLEANED_MGF,
        params             = config["params_files"]["mn"],
        ms2deepscore_model = config["models"]["ms2deepscore"],
        spec2vec_model     = config["models"]["spec2vec"]
    output:
        base      = OUT_DIR / "networks" / "{sim}" / "comp_{size}" / "{matrix}" / "base.cx",
        threshold = OUT_DIR / "networks" / "{sim}" / "comp_{size}" / "{matrix}" / "threshold.cx",
        rescued   = OUT_DIR / "networks" / "{sim}" / "comp_{size}" / "{matrix}" / "rescued.cx"
    log:
        OUT_DIR / "logs" / "mn" / "{sim}_comp_{size}_{matrix}.log"
    resources:
        mem_mb = 8000
    params:
        thresh_flag = lambda w: "--similarity-threshold 0.85" if w.sim == "ms2deepscore" else "--similarity-threshold 0.7",
        matrix_flag = lambda w: "--use-average-similarity" if w.matrix == "average" else ""
    shell:
        """
        set -euo pipefail
        python src/mn \
            --defaults "{input.params}" \
            --mgf-cleaned "{input.mgf}" \
            --ms2deepscore-model-path "{input.ms2deepscore_model}" \
            --spec2vec-model-path "{input.spec2vec_model}" \
            --similarity-type "{wildcards.sim}" \
            --max-component-size "{wildcards.size}" \
            --base-graph-path "{output.base}" \
            --threshold-graph-path "{output.threshold}" \
            --rescued-graph-path "{output.rescued}" \
            --average-similarity-file "{OUT_DIR}/networks/{wildcards.sim}_average_similarity.npz" \
            --similarity-file "{OUT_DIR}/networks/{wildcards.sim}_similarity.npz" \
            --support-file "{OUT_DIR}/networks/{wildcards.sim}_support.npz" \
            {params.thresh_flag} \
            {params.matrix_flag} > {log} 2>&1
        """

rule ms2lda:
    message:
        "Training MS2LDA model | Motifs: {wildcards.motifs}"
    input:
        params = config["params_files"]["ms2lda"],
        mgf    = INPUT_MGF,
        clean  = CLEANED_MGF
    output:
        model  = OUT_DIR / "ms2lda" / "motifs_{motifs}" / "model.lda",
        motifs = OUT_DIR / "ms2lda" / "motifs_{motifs}" / "motifs.mgf"
    log:
        OUT_DIR / "logs" / "ms2lda" / "motifs_{motifs}.log"
    resources:
        mem_mb = 8000
    shell:
        """
        set -euo pipefail
        python src/ms2lda \
            --defaults "{input.params}" \
            --mgf "{input.mgf}" \
            --mgf-cleaned "{input.clean}" \
            --nr-of-motifs "{wildcards.motifs}" \
            --model-path "{output.model}" \
            --motifs-path "{output.motifs}" > {log} 2>&1
        """

rule motif_overlap:
    message:
        "Calculating Motif Overlaps | Motifs: {wildcards.motifs}"
    input:
        mgf       = CLEANED_MGF,
        lda_model = OUT_DIR / "ms2lda" / "motifs_{motifs}" / "model.lda"
    output:
        overlaps = OUT_DIR / "ms2lda" / "motifs_{motifs}" / "overlaps.csv"
    log:
        OUT_DIR / "logs" / "motif_overlap" / "motifs_{motifs}.log"
    resources:
        mem_mb = 4000
    shell:
        """
        set -euo pipefail
        python src/motif_metadata/motif_detection.py \
            --mgf "{input.mgf}" \
            --model "{input.lda_model}" \
            --result "{output.overlaps}" \
            --dataset-acquisition-type DDA \
            --dataset-significant-digits 2 > {log} 2>&1
        """

rule snapms:
    message:
        "Running SnapMS | Motifs: {wildcards.motifs} | Sim: {wildcards.sim} | Size: {wildcards.size} | Matrix: {wildcards.matrix} | Graph: {wildcards.graph}"
    input:
        params       = config["params_files"]["snapms"],
        mn           = OUT_DIR / "networks" / "{sim}" / "comp_{size}" / "{matrix}" / "{graph}.cx",
        overlaps     = OUT_DIR / "ms2lda" / "motifs_{motifs}" / "overlaps.csv",
        structure_db = config["models"]["structure_db"]
    output:
        result_dir   = directory(OUT_DIR / "snapms" / "motifs_{motifs}" / "{sim}_comp_{size}_{matrix}_{graph}")
    log:
        OUT_DIR / "logs" / "snapms" / "motifs_{motifs}_{sim}_comp_{size}_{matrix}_{graph}.log"
    resources:
        mem_mb = 8000
    shell:
        """
        set -euo pipefail
        {{
            python src/motif_metadata/mn_motif_metadata.py \
                --mn-file "{input.mn}" \
                --overlaps "{input.overlaps}" \
                --threshold 0.01

            python src/snapms \
                --graph "{input.mn}" \
                --defaults "{input.params}" \
                --result-folder "{output.result_dir}" \
                --reference-db "{input.structure_db}"

            python src/annotation_metadata/relay_annotation_info.py \
                --mn-file "{input.mn}" \
                --annotation-folder "{output.result_dir}"

            python src/annotation_metadata/smiles_flag.py \
                --mn-file "{input.mn}" \
                --annotation-folder "{output.result_dir}"
        }} > {log} 2>&1
        """

rule plot_motifs:
    message:
        "Generating Spectral Plots | Motifs: {wildcards.motifs}"
    input:
        motifs = OUT_DIR / "ms2lda" / "motifs_{motifs}" / "motifs.mgf",
        model  = OUT_DIR / "ms2lda" / "motifs_{motifs}" / "model.lda",
        params = config["params_files"]["ms2lda"],
        mgf    = CLEANED_MGF
    output:
        plot_dir = directory(OUT_DIR / "ms2lda" / "motifs_{motifs}_plots")
    log:
        OUT_DIR / "logs" / "plot_motifs" / "motifs_{motifs}.log"
    resources:
        mem_mb = 4000
    shell:
        """
        set -euo pipefail
        python src/motif_metadata/spectral_plots.py \
            --defaults "{input.params}" \
            --library "{input.mgf}" \
            --query "{input.motifs}" \
            --similarity-type overlap \
            --flash-tolerance 0.01 \
            --lda-model-path "{input.model}" \
            --max-batch-size 200 \
            --similarity-threshold 0.01 \
            --top-n 100 \
            --result-folder "{output.plot_dir}" > {log} 2>&1
        """