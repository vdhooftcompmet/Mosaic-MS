import os
import pandas as pd
from pathlib import Path

REPO = Path(workflow.basedir).parent.parent.resolve()
workdir: str(REPO)
print(f"{REPO = }")

# Parameter grids
SIMILARITY_TYPES = ["cos", "modcos", "spec2vec", "ms2deepscore"]
MAX_COMPONENT_SIZES = [10, 20, 50]  # Example values; adjust as needed
USE_AVERAGE_SIMILARITY = [True, False]
GRAPH_TYPES = ["base", "threshold", "rescued"]

# Input dependencies
MGF_FILE = "data/test_file.mgf"
REFERENCE_DB = "data/coconut_db.jsonl"

# Output aggregated table
FINAL_SUMMARY = "snakemake/effect_of_network/results/final_scores_summary.csv"


rule all:
    input:
        FINAL_SUMMARY


# Step 1: Run Molecular Networking to generate base, threshold, and rescued graphs for a parameter set
rule run_mn:
    input:
        mgf = MGF_FILE
    output:
        base = "snakemake/effect_of_network/results/networks/{sim_type}_mcs{mcs}_avg{avg}/base.cx",
        threshold = "snakemake/effect_of_network/results/networks/{sim_type}_mcs{mcs}_avg{avg}/threshold.cx",
        rescued = "snakemake/effect_of_network/results/networks/{sim_type}_mcs{mcs}_avg{avg}/rescued.cx"
    params:
        sim_type = "{sim_type}",
        sim_th = lambda wildcards: 8.5 if wildcards.sim_type == "ms2deepscore" else 0.7,
        mcs = "{mcs}",
        avg_flag = lambda wildcards: "--use-average-similarity" if wildcards.avg == "True" else "--no-use-average-similarity"
    shell:
        """
        python cli.py run-mn \
            --mgf {input.mgf} \
            --similarity-type {params.sim_type} \
            --similarity-threshold {params.sim_th} \
            --max-component-size {params.mcs} \
            {params.avg_flag} \
            --base-graph-path {output.base} \
            --threshold-graph-path {output.threshold} \
            --rescued-graph-path {output.rescued}
        """


# Step 2: Run SNAP-MS on a specific graph (.cx file)
rule run_snapms:
    input:
        graph = "snakemake/effect_of_network/results/networks/{sim_type}_mcs{mcs}_avg{avg}/{graph_type}.cx",
        db = REFERENCE_DB
    output:
        directory("snakemake/effect_of_network/results/snapms/{sim_type}_mcs{mcs}_avg{avg}/{graph_type}_annotations")
    shell:
        """
        python cli.py run-snapms \
            --graph {input.graph} \
            --reference-db {input.db} \
            --result-folder {output}
        """


# Step 3: Score the annotations for a specific graph configuration
rule score_graph:
    input:
        graph = "snakemake/effect_of_network/results/networks/{sim_type}_mcs{mcs}_avg{avg}/{graph_type}.cx",
        annotations = "snakemake/effect_of_network/results/snapms/{sim_type}_mcs{mcs}_avg{avg}/{graph_type}_annotations"
    output:
        csv = "snakemake/effect_of_network/results/scores/{sim_type}_mcs{mcs}_avg{avg}/{graph_type}.csv"
    shell:
        """
        python -m src.benchmark.scoring \
            -m {input.graph} \
            -a {input.annotations} \
            -o {output.csv}
        """


# Step 4: Aggregate all scores into a single final CSV file
rule aggregate_scores:
    input:
        scores = expand(
            "snakemake/effect_of_network/results/scores/{sim_type}_mcs{mcs}_avg{avg}/{graph_type}.csv",
            sim_type=SIMILARITY_TYPES,
            mcs=MAX_COMPONENT_SIZES,
            avg=USE_AVERAGE_SIMILARITY,
            graph_type=GRAPH_TYPES
        )
    output:
        csv = FINAL_SUMMARY
    run:
        combined_rows = []
        for file_path in input.scores:
            # Extract metadata parameters from file path structure
            parts = file_path.split("/")
            param_dir = parts[2]       # e.g., 'ms2deepscore_mcs20_avgTrue'
            graph_filename = parts[3]  # e.g., 'base.csv'

            # Parse parameters from directory string
            sim_type, rest = param_dir.split("_mcs")
            mcs_str, avg_str = rest.split("_avg")

            sim_th = 8.5 if sim_type == "ms2deepscore" else 0.7
            graph_type = os.path.splitext(graph_filename)[0]

            # Read single-line metric CSV from scoring.py
            df = pd.read_csv(file_path)

            # Prepend parameter columns
            df.insert(0, "graph_type", graph_type)
            df.insert(0, "use_average_similarity", avg_str == "True")
            df.insert(0, "max_component_size", int(mcs_str))
            df.insert(0, "similarity_threshold", float(sim_th))
            df.insert(0, "similarity_type", sim_type)

            combined_rows.append(df)

        final_df = pd.concat(combined_rows, ignore_index=True)
        final_df.to_csv(output.csv, index=False)
